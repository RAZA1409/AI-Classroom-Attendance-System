# ==========================================
# AI Classroom Attendance System - Configuration Template
# Copy this file to .env and adjust values as needed.
# ==========================================

# Camera configuration (0 for default built-in webcam)
CAMERA_INDEX=0

# Face recognition settings
FACE_SIMILARITY_THRESHOLD=0.6
MIN_PRESENCE_SECONDS=5
MIN_FRAMES=100
ATTENDANCE_COOLDOWN_SECONDS=600

# File paths
FACE_DATABASE_PATH=face_embeddings.pkl
ATTENDANCE_LOG_PATH=attendance.csv
YOLO_MODEL_PATH=yolov8n.pt
STUDENTS_DIR=students

